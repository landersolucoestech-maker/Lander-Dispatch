NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=5000

# Local PostgreSQL. Supabase is intentionally not configured at this stage.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/lander_dispatch

# Protected development seed.
# Do not persist SEED_DEV_CONFIRM in .env.local. Supply it only for the seed command.
# Local 127.0.0.1/localhost databases named lander_dispatch are accepted automatically.
# Remote development databases also require an exact host:port/database allowlist value.
SEED_DEV_ALLOWED_DATABASE=

# Frontend/API local URLs
APP_URL=http://127.0.0.1:5000
WEB_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VITE_API_URL=http://127.0.0.1:5000

# Authentication is enabled by default.
# Set AUTH_DISABLED=true only for explicit loopback-only local development.
AUTH_DISABLED=false
COOKIE_SECURE=false

# Used only by: pnpm auth:bootstrap-owner
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=

# Base64-encoded 32-byte key used to encrypt carrier banking data.
# Generate once and store only in the environment or secret manager:
# openssl rand -base64 32
BANK_DATA_ENCRYPTION_KEY=

# S3-compatible object storage. These defaults target local MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRIVATE_BUCKET=lander-dispatch-private
S3_PUBLIC_BUCKETS=lander-dispatch-public

# Optional AI PDF extraction. The API starts normally without these values.
OPENAI_API_KEY=
OPENAI_PDF_EXTRACTION_MODEL=
