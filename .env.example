NODE_ENV=development
PORT=5000

# Local PostgreSQL. Supabase is intentionally not configured at this stage.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/lander_dispatch

# Frontend/API local URLs
APP_URL=http://localhost:5000
WEB_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Authentication values will be finalized during the local-auth refactor.
SESSION_SECRET=replace-with-a-long-random-local-secret
COOKIE_SECURE=false

# Optional AI integration. The API must remain able to start without this value.
OPENAI_API_KEY=
