NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# Local PostgreSQL. Supabase is intentionally not configured at this stage.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/lander_dispatch

# Frontend/API local URLs
APP_URL=http://127.0.0.1:5000
WEB_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VITE_API_URL=http://127.0.0.1:5000

# Development-only authentication bypass.
# The API refuses to start with this enabled outside development or on a public bind.
AUTH_DISABLED=true
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-long-random-local-secret

# Optional AI integration. The API must remain able to start without this value.
OPENAI_API_KEY=
